# =============================================================================
# Run tests (required to clone and run Playwright)
# =============================================================================

# Base URL of the Didaxis environment under test
DIDAXIS_URL=https://test.didaxis.studio

# Admin (or primary) account used by auth.setup and feature tests
DIDAXIS_EMAIL=your-email@example.com

# Password for DIDAXIS_EMAIL
DIDAXIS_PASSWORD=your-password

# Bearer token for REST cleanup / API helpers (GET/DELETE programs, etc.)
DIDAXIS_API_TOKEN=your-api-token

# Optional — secondary account for permission / non-admin probes
DIDAXIS_ALT_EMAIL=alt-user@example.com
DIDAXIS_ALT_PASSWORD=alt-password

# =============================================================================
# Agent / CI setup (not needed for `npx playwright test` alone)
# =============================================================================

# Cursor API key for headless `agent` in .github/workflows/test-generation.yml
CURSOR_API_KEY=your-cursor-api-key

# Atlassian API token (Jira REST Basic auth in CI; MCP token also in Cursor settings)
ATLASSIAN_API_TOKEN=your-atlassian-api-token

# Jira Cloud site URL (e.g. https://your-org.atlassian.net)
ATLASSIAN_BASE_URL=https://your-org.atlassian.net

# Atlassian account email paired with ATLASSIAN_API_TOKEN for Basic auth
ATLASSIAN_EMAIL=your-atlassian-account@example.com
